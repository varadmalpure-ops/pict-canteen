# Copy to .env and fill in values from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=

# Razorpay (Cloud Functions config — do NOT put secrets in VITE_ vars)
# firebase functions:config:set razorpay.key_id="rzp_..." razorpay.key_secret="..." razorpay.webhook_secret="..."
