rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bootstrap admins by verified email (server-side rules only — not shipped in the Vite client).
    // Prefer custom claim admin==true or admins/{uid} for ongoing access.
    function isBootstrapAdminEmail() {
      return request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'canteen-staff@gmail.com',
          'varadmalpure@gmail.com'
        ];
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapAdminEmail()
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['pending', 'verified']);

      // Students may update photo paths / password-related profile fields only.
      // They cannot change verificationStatus, uid, or email.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verificationStatus', 'uid', 'email', 'lastOrderAt'])
      );
    }

    match /menuItems/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Token counter: Admin SDK / Cloud Functions only
    match /metadata/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Full order documents — never creatable from clients
    match /orders/{orderId} {
      allow create: if false;
      allow read: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Public kitchen display — only token + status (no PII / UTR / email)
    match /displayBoard/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment intents metadata readable by owner (optional gateway flow)
    match /paymentIntents/{intentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // UTR deduplication ledger — written only by Cloud Functions via Admin SDK
    match /usedUTRs/{utr} {
      allow read, write: if false;
    }

    // PNR (Student Roll Number) unique registry ledger
    match /pnrs/{pnr} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/pnrs/$(pnr));
      allow update, delete: if isAdmin();
    }
  }
}
