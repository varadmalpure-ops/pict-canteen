rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bootstrap admins by verified email (rules only — not in the Vite client).
    function isBootstrapAdminEmail() {
      return request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'canteen-staff@gmail.com',
          'varadmalpure@gmail.com'
        ];
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapAdminEmail()
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.verificationStatus == 'pending';

      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verificationStatus', 'uid', 'email', 'lastOrderAt'])
      );
    }

    match /menuItems/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /metadata/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow create: if false;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Public Live TV — token + status only (Cloud Functions write the stripped shape)
    match /displayBoard/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paymentIntents/{intentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /usedUTRs/{utr} {
      allow read, write: if false;
    }

    match /pnrs/{pnr} {
      allow read: if isAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/pnrs/$(pnr));
      allow update, delete: if isAdmin();
    }
  }
}
